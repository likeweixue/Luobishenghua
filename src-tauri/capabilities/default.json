{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "落笔生花默认权限：原生保存对话框 + 读写用户选择的文件 + 拖拽文件读取",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "/tmp/**" }, { "path": "/private/tmp/**" }]
    }
  ]
}
